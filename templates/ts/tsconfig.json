{
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "target": "es2015",
        "module": "ESNext",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "lib": ["ESNext", "DOM"],
        "types": ["vite/client"],
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "forceConsistentCasingInFileNames": true
    },
    "exclude": ["node_modules", "dist"]
}
